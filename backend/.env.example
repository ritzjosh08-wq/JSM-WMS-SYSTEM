# Copy to .env for local dev. In production (Render), set these as environment
# variables in the service's dashboard instead of committing a real .env file.

# Supabase Postgres connection string. Use the SESSION-mode pooler URL (port 5432,
# host contains "pooler.supabase.co") — Prisma needs session mode, not the 6543
# transaction-mode pooler, unless you also append ?pgbouncer=true.
# Find it in Supabase: Project Settings -> Database -> Connection string -> "URI" (Session pooler).
DATABASE_URL="postgresql://postgres.xxxxxxxx:[email protected]:5432/postgres"

# Optional: a DIRECT (non-pooled) connection, only needed if you later wire up
# `prisma migrate deploy` (Project Settings -> Database -> Connection string -> "Direct connection").
# DIRECT_URL="postgresql://postgres:[email protected]:5432/postgres"

# Random 32+ character secret used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""

NODE_ENV="production"
PORT="5001"

# Comma-separated list of allowed frontend origins (staff WMS + customer portal).
# Leave unset locally to allow all origins during dev.
CORS_ORIGIN="https://your-staff-frontend.example.com,https://your-customer-portal.example.com"

# Optional: absolute path to a writable, PERSISTENT directory for dynamic-users.json and
# customer-permissions.json (the only backend state that isn't in Postgres). Required on
# any host with an ephemeral filesystem (e.g. Render web services without a Disk attached) —
# without it, admin-created worker/customer accounts and saved permissions are lost on every
# deploy/restart. Point this at a mounted persistent disk, e.g. "/data" on Render.
# Leave unset for local dev (falls back to the backend folder itself).
# DATA_DIR="/data"
