# This used to point at a temporary `trycloudflare.com` quick-tunnel URL, which only stays
# alive as long as someone's laptop is running `cloudflared tunnel` — that tunnel is long
# gone, so every production build of this app has been calling a dead URL. The WMS backend
# has been on permanent, always-on hosting (Render) since then; point here instead.
VITE_API_BASE=https://jsm-logistics-backend.onrender.com/api
